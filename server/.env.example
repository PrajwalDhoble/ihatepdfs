NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=https://www.ihatepdf.net
SITE_URL=https://www.repairmypdf.com

# Optional — leave blank to run without MongoDB (anonymous MVP mode)
MONGO_URI=

TEMP_DIR=/tmp/repairmypdf
MAX_UPLOAD_MB=100
JOB_EXPIRY_MINUTES=60

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Paid conversion API (CloudConvert) ---
# Required for: Word/Excel/PowerPoint <-> PDF, PDF to JPG, PDF to PNG, OCR PDF.
# 1. Sign up at https://cloudconvert.com (free tier available to test with)
# 2. Dashboard -> API v2 -> API Keys -> create a key
# 3. Paste it below, replacing the placeholder
CLOUDCONVERT_API_KEY=REPLACE_WITH_YOUR_CLOUDCONVERT_API_KEY

# --- qpdf (free, but a system binary you must install yourself) ---
# Required for: Protect PDF, Unlock PDF.
# Install: apt install qpdf (Linux) / brew install qpdf (Mac) / see README for Windows.
# Leave as "qpdf" if it's on your PATH, or set a full path to the executable.
QPDF_PATH=qpdf

# --- AI API (paid) for Summarize PDF / Ask AI About a PDF ---
# Any OpenAI-compatible chat completions endpoint works.
AI_API_KEY=REPLACE_WITH_YOUR_AI_API_KEY
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
