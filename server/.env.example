NODE_ENV=production
PORT=4000

CLIENT_ORIGIN=https://www.ihatepdf.net
SITE_URL=https://www.ihatepdf.net

MONGO_URI=

TEMP_DIR=/tmp/repairmypdf
MAX_UPLOAD_MB=100
JOB_EXPIRY_MINUTES=60

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

CLOUDCONVERT_API_KEY=YOUR_ACTUAL_CLOUDCONVERT_KEY

QPDF_PATH=qpdf


# --- AI API (Gemini, free tier) for Summarize PDF / Ask AI About a PDF /
#     Translate PDF / AI Resume Review ---
# 1. Go to https://aistudio.google.com/apikey and sign in with a Google account
# 2. Click "Create API key" (no billing required for the free tier)
# 3. Paste it below
AI_API_KEY=YOUR_ACTUAL_GEMINI_KEY
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash